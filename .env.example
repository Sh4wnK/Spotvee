# Spotvee server configuration. Copy to .env and fill in real values.
# Never commit .env. See README.md for where to obtain each value.

# --- Spotify ---
# Create a Spotify app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
# Only required for non-PKCE flows (PKCE only needs the client ID).
SPOTIFY_CLIENT_SECRET=
# Must match the redirect URI registered in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://localhost:8080/api/auth/callback

# --- Govee ---
# Govee developer API key: https://developer.govee.com
GOVEE_API_KEY=

# --- Server ---
# Bearer token the mobile app presents on every request.
SPOTVEE_APP_TOKEN=
# HTTP listen address.
SPOTVEE_LISTEN_ADDR=:8080

# --- Token persistence ---
# Where the encrypted Spotify token is stored (0600 perms).
SPOTVEE_TOKEN_FILE=spotvee-state.json
# Where the 32-byte encryption key lives (0600, created once).
SPOTVEE_TOKEN_KEY_FILE=.spotvee-token-key

# --- Polling (adaptive) ---
SPOTVEE_POLL_INTERVAL=3s
SPOTVEE_MIN_POLL=500ms
SPOTVEE_MAX_POLL=5s
SPOTVEE_FAST_POLL_LEAD=10s

# --- Palette extraction ---
SPOTVEE_PALETTE_SIZE=4
SPOTVEE_SAT_FLOOR=0.18
SPOTVEE_LUM_HIGH=0.86
SPOTVEE_LUM_LOW=0.12
SPOTVEE_VIVID_WEIGHT=0.7

# --- Optional extras ---
SPOTVEE_PALETTE_CYCLE=false
SPOTVEE_IMAGE_CACHE_ENTRIES=256
SPOTVEE_IMAGE_CACHE_BYTES=67108864
SPOTVEE_MAX_ART_BYTES=8388608
SPOTVEE_METRICS=true
SPOTVEE_LOG_LEVEL=info